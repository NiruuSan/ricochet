# Server-side settings only. Never prefix secrets with NEXT_PUBLIC_.
RICOCHET_ADMIN_USER_ID=
# disabled is the safe default; devnet is the only supported active network.
SOLANA_NETWORK=disabled
SOLANA_RPC_URL=
# Base64-encoded 32 random bytes. Keep a separate secure backup before funding wallets.
# Loss of this key makes the encrypted deposit/pool wallets unrecoverable.
SOLANA_VAULT_KEY=
