# Server-side settings only. Never prefix secrets with NEXT_PUBLIC_.

# Turso (libSQL) database. Create one with `turso db create ricochet`, then
# `turso db show ricochet --url` and `turso db tokens create ricochet`.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Auth.js. Generate AUTH_SECRET with `npx auth secret` or `openssl rand -base64 32`.
# GitHub OAuth App callback URL: https://<your-domain>/api/auth/callback/github
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# The administrator's player ID, shaped like `github:12345678` (their numeric GitHub user ID).
RICOCHET_ADMIN_USER_ID=

# disabled is the safe default; devnet is the only supported active network.
SOLANA_NETWORK=disabled
SOLANA_RPC_URL=
# Base64-encoded 32 random bytes. Keep a separate secure backup before funding wallets.
# Loss of this key makes the encrypted deposit/pool wallets unrecoverable.
SOLANA_VAULT_KEY=
