# Server-side settings only. Never prefix secrets with NEXT_PUBLIC_.

# Turso (libSQL) database. Create one with `turso db create ricochet`, then
# `turso db show ricochet --url` and `turso db tokens create ricochet`.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Private Vercel Blob store for bug-report images and videos. Connect a PRIVATE
# Blob store to this project in Vercel Storage; this variable is added automatically.
BLOB_READ_WRITE_TOKEN=
# Vercel sends this secret to the existing daily sweep, which also removes
# abandoned attachments. Generate a random secret of at least 32 characters.
CRON_SECRET=

# Auth.js. Generate AUTH_SECRET with `npx auth secret` or `openssl rand -base64 32`.
# GitHub OAuth App callback URL: https://<your-domain>/api/auth/callback/github
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Optional. Each provider's button appears once both of its values are set.
# Google (Google Cloud Console → Credentials → OAuth client ID, type Web application)
# redirect URI: https://<your-domain>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Discord (Developer Portal → Applications → OAuth2) redirect: https://<your-domain>/api/auth/callback/discord
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=

# The administrator's player ID, shaped like `github:12345678` (their numeric GitHub user ID).
RICOCHET_ADMIN_USER_ID=

# disabled is the safe default; devnet is the only supported active network.
SOLANA_NETWORK=disabled
# HTTPS devnet endpoint. https://api.devnet.solana.com works but rate-limits cloud hosts;
# a free devnet endpoint from an RPC provider is more reliable.
SOLANA_RPC_URL=
# Base64-encoded 32 random bytes. Keep a separate secure backup before funding wallets.
# Loss of this key makes the encrypted deposit/pool wallets unrecoverable.
SOLANA_VAULT_KEY=

# Web push: generate once with `npx web-push generate-vapid-keys`. Keep the private key server-only.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@example.com
